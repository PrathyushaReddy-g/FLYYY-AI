# FLYYY.AI Privacy-Preserving CDP Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="FLYYY.AI Privacy-Preserving CDP"

# Database URLs (PostgreSQL or SQLite)
DATABASE_URL_SOURCE=sqlite:///./source.db
DATABASE_URL_PROTECTED=sqlite:///./protected.db
DATABASE_URL_VAULT=sqlite:///./vault.db
DATABASE_URL_POLICY=sqlite:///./policy.db
DATABASE_URL_AUDIT=sqlite:///./audit.db

# Cryptographic Keys (256-bit Hex - Automatically generated if missing)
FPE_KEY_HEX=
VAULT_KEY_HEX=
TOKEN_KEY_HEX=

# Authentication
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# SMTP / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@flyyy.ai
